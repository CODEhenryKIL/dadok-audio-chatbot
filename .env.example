# 기존 챗봇 (모델·프롬프트·키 이름 유지)
OPENAI_API_KEY=
VOYAGE_API_KEY=
DADOK_SERVER_URL=
DADOK_SERVER_TOKEN=
DADOK_AUTH_USER_ID=
DADOK_CHILD_ID=demo-child
DADOK_RECORD_SNAPSHOT=

# STT/TTS 공통 공급자: 실제 키와 voiceId는 .env에만 입력
ELEVENLABS_API_KEY=
STT_PROVIDER=elevenlabs
STT_MODEL=scribe_v2_realtime
STT_LANGUAGE=ko
# 실시간 keyterms 최대 50개·항목당 20자, API 요금 20% 추가; 빈 값이면 미사용.
STT_KEYTERMS=분유,수유,이유식,배변,낮잠,밤잠,수면
TTS_PROVIDER=elevenlabs
TTS_MODEL=eleven_flash_v2_5
TTS_VOICE=
# 선택 가능한 목소리 (실제 ID는 .env에만 저장). TTS_VOICE가 기본 선택값입니다.
# 예: TTS_VOICE_OPTIONS='[{"id":"VOICE_ID_1","name":"목소리 1"},{"id":"VOICE_ID_2","name":"목소리 2"}]'
TTS_VOICE_OPTIONS=[]

# 기능별 비교 (변경 후 서버 재시작)
VOICE_ENABLED=true
VAD_ENABLED=true
TURN_DETECTION_ENABLED=true
BARGE_IN_ENABLED=true
PREEMPTIVE_GENERATION_ENABLED=true
PREEMPTIVE_TTS_ENABLED=false

# 로컬 self-host 개발 서버 전용. Cloud 계정 불필요.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
VOICE_WEB_PORT=8766
